# LLM Gateway Configuration
GATEWAY_TRANSPORT=http
OLLAMA_API_BASE=http://localhost:11434
DEFAULT_MODEL=ollama/mistral:latest
FALLBACK_MODEL=ollama/llama3.2
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
LLM_GATEWAY_DB_PATH=./llm_gateway.db
LLM_GATEWAY_JSON_LOG=./gateway_audit.jsonl

# Agent Client Configuration
GATEWAY_URL=http://localhost:8000
AGENT_WORKSPACE_DIR=./workspace

# Smart Router Feature Flag & Settings
USE_SMART_ROUTING=true
SMART_ROUTER_DEFAULT_MODEL=ollama/llama3.2:latest
SMART_ROUTER_CONFIG_PATH=./smart_router_config.json

