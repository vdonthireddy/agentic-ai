# LLM Gateway Configuration
GATEWAY_TRANSPORT=http
DEFAULT_MODEL=ollama/gemma2:2b
FALLBACK_MODEL=ollama/llama3.2
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000
LLM_GATEWAY_DB_PATH=./llm_gateway.db
LLM_GATEWAY_JSON_LOG=./gateway_audit.jsonl

# Local LLM Backend (Ollama)
OLLAMA_API_BASE=http://localhost:11434

# Cloud LLM Provider API Keys (Optional - only required if invoking cloud models)
# OpenAI
OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1

# Anthropic Claude
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Groq Cloud
GROQ_API_KEY=

# Mistral AI
MISTRAL_API_KEY=

# DeepSeek
DEEPSEEK_API_KEY=

# OpenRouter
OPENROUTER_API_KEY=

# Agent Client Configuration
GATEWAY_URL=http://localhost:8000
AGENT_WORKSPACE_DIR=./workspace
